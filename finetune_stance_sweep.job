#!/bin/bash

#SBATCH --job-name=finetune_stance_sweep
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=n.kalra@tilburguniversity.edu
#SBATCH --array=0-1

# Runs several Qwen3-1.7B fine-tuning experiments (different training datasets) as one
# SLURM job array instead of duplicating finetune_stance.job per variant (which would
# drift out of sync the moment one copy gets fixed and the others don't). Submit this
# ONCE (`sbatch finetune_stance_sweep.job`) and SLURM queues every row below as an
# independent task -- as many run in parallel as A100 capacity allows, the rest just
# queue. Each row is one complete experiment config; add/remove rows in the arrays
# below and update --array above to match (0-indexed, inclusive -- 2 rows = 0-1).
#
# Rows below use what's actually ready right now: only
# `nityaak/semeval-stance-conversations` and `nityaak/stance-combined-v1` exist as
# training datasets so far -- mtcsd-only, EZ-STANCE-only, and all-three still need
# their own conversations-formatted dataset prepped + pushed first (not yet done).

source venv/bin/activate
export HF_HUB_CACHE=/scratch-shared/$USER/.cache_dir/hub

# --- experiment rows -- index i across every array below = one experiment ---
DATA_DIRS=(
    "nityaak/semeval-stance-conversations"
    "nityaak/stance-combined-v1"
)
PUSH_IDS=(
    "nityaak/qwen3-1.7b-stance-semeval-qlora"
    "nityaak/qwen3-1.7b-stance-combined-qlora"
)

i=$SLURM_ARRAY_TASK_ID
DATA_DIR="${DATA_DIRS[$i]}"
PUSH_TO_HUB_ID="${PUSH_IDS[$i]}"

echo "Experiment $i: data_dir=$DATA_DIR push_to_hub_id=$PUSH_TO_HUB_ID"

python finetune_stance.py \
                          --pretrained_model_name_or_path unsloth/Qwen3-1.7B-unsloth-bnb-4bit \
                          --no_from_foundation_model \
                          --data_dir "$DATA_DIR" \
                          --push_to_hub_id "$PUSH_TO_HUB_ID" \
                          --output_dir /scratch-shared/$USER/finetune_results/sweep_$i/ \
                          --max_length 512 \
                          --per_device_train 8 \
                          --per_device_eval 8 \
                          --num_train_epochs 1 \
                          --optim adamw_8bit \
                          --bf16 True \
                          --gradient_accumulation_steps 2 \
                          --packing \
                          --logging_steps 10 \
                          --weight_decay 0.01 \
                          --warmup_ratio 0.1 \
