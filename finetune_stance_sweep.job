#!/bin/bash

#SBATCH --job-name=finetune_stance_sweep
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=n.kalra@tilburguniversity.edu
#SBATCH --array=0-6

# Runs the full experiment matrix -- all 7 non-empty subsets of {semeval, mtcsd,
# ezstance} -- as one SLURM job array instead of duplicating finetune_stance.job per
# variant (which would drift out of sync the moment one copy gets fixed and the
# others don't). Submit this ONCE (`sbatch finetune_stance_sweep.job`) and SLURM
# queues every row below as an independent task -- as many run in parallel as A100
# capacity allows, the rest just queue.
#
# Only DATA_DIRS needs editing to add/remove experiments (update --array to match,
# 0-indexed inclusive -- 7 rows = 0-6) -- push_to_hub_id and output_dir are both
# derived from each row the same way as finetune_stance.job, so there's nothing else
# to keep in sync per row.

source venv/bin/activate
export HF_HUB_CACHE=/scratch-shared/$USER/.cache_dir/hub

# --- experiment rows -- one entry per task ---
DATA_DIRS=(
    "nityaak/stance-matrix-semeval"
    "nityaak/stance-matrix-mtcsd"
    "nityaak/stance-matrix-ezstance"
    "nityaak/stance-matrix-semeval-mtcsd"
    "nityaak/stance-matrix-semeval-ezstance"
    "nityaak/stance-matrix-mtcsd-ezstance"
    "nityaak/stance-matrix-semeval-mtcsd-ezstance"
)

DATA_DIR="${DATA_DIRS[$SLURM_ARRAY_TASK_ID]}"
DATASET_NAME="${DATA_DIR##*/}"
PUSH_TO_HUB_ID="nityaak/qwen3-4b-${DATASET_NAME}-qlora"
OUTPUT_DIR="/scratch-shared/$USER/finetune_results/qwen3-4b-${DATASET_NAME}/"

echo "Experiment $SLURM_ARRAY_TASK_ID: data_dir=$DATA_DIR push_to_hub_id=$PUSH_TO_HUB_ID"

python finetune_stance.py \
                          --pretrained_model_name_or_path unsloth/Qwen3-4B-Instruct-2507-unsloth-bnb-4bit \
                          --no_from_foundation_model \
                          --data_dir "$DATA_DIR" \
                          --push_to_hub_id "$PUSH_TO_HUB_ID" \
                          --output_dir "$OUTPUT_DIR" \
                          --max_length 512 \
                          --per_device_train 8 \
                          --per_device_eval 8 \
                          --num_train_epochs 1 \
                          --optim adamw_8bit \
                          --bf16 True \
                          --gradient_accumulation_steps 2 \
                          --packing \
                          --logging_steps 10 \
                          --weight_decay 0.01 \
                          --warmup_ratio 0.1 \
