#!/bin/bash

#SBATCH --job-name=finetune_stance_sweep_phi4_14b
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=n.kalra@tilburguniversity.edu
#SBATCH --array=0-6

# Phi-4 (14B, not Phi-4-mini) across all 7 combo-matrix datasets. Separate file from
# finetune_stance_sweep.job (which is being used for Qwen3-8B in parallel) so the two
# can run concurrently on separate GPU allocations without one overwriting the other's
# in-progress state -- learned the hard way when swapping models in the same file
# clobbered an earlier run's HF repo commit history.
#
# ~18GB VRAM headroom on a 40GB A100 for a 14B QLoRA run (less margin than the smaller
# models) -- if this OOMs, halve --per_device_train and double
# --gradient_accumulation_steps to keep the same effective batch size.

source venv/bin/activate
export HF_HUB_CACHE=/scratch-shared/$USER/.cache_dir/hub

# --- experiment rows -- one entry per task ---
DATA_DIRS=(
    "nityaak/stance-matrix-semeval"
    "nityaak/stance-matrix-mtcsd"
    "nityaak/stance-matrix-ezstance"
    "nityaak/stance-matrix-semeval-mtcsd"
    "nityaak/stance-matrix-semeval-ezstance"
    "nityaak/stance-matrix-mtcsd-ezstance"
    "nityaak/stance-matrix-semeval-mtcsd-ezstance"
)

DATA_DIR="${DATA_DIRS[$SLURM_ARRAY_TASK_ID]}"
DATASET_NAME="${DATA_DIR##*/}"
PUSH_TO_HUB_ID="nityaak/phi4-14b-${DATASET_NAME}-qlora"
OUTPUT_DIR="/scratch-shared/$USER/finetune_results/phi4-14b-${DATASET_NAME}/"

echo "Experiment $SLURM_ARRAY_TASK_ID: data_dir=$DATA_DIR push_to_hub_id=$PUSH_TO_HUB_ID"

python finetune_stance.py \
                          --pretrained_model_name_or_path unsloth/phi-4-unsloth-bnb-4bit \
                          --no_from_foundation_model \
                          --data_dir "$DATA_DIR" \
                          --push_to_hub_id "$PUSH_TO_HUB_ID" \
                          --output_dir "$OUTPUT_DIR" \
                          --max_length 512 \
                          --per_device_train 8 \
                          --per_device_eval 8 \
                          --num_train_epochs 1 \
                          --optim adamw_8bit \
                          --bf16 True \
                          --gradient_accumulation_steps 2 \
                          --packing \
                          --logging_steps 10 \
                          --weight_decay 0.01 \
                          --warmup_ratio 0.1 \
